{
  "manifest_version": 3,
  "name": "BB 资料下载助手",
  "version": "1.1.0",
  "description": "按课程号扫描资料，下载前核对本地历史，后台下载并保留课程目录层级。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "downloads",
    "storage",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://bb.cuhk.edu.cn/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "打开 BB 资料下载助手"
  }
}
